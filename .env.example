# EcoVault Lite 环境变量示例。复制为 .env 并按需修改。
# Copy this file to .env and adjust values. NEVER commit the real .env.

# 服务监听端口 (Server port)
ECOVAULT_PORT=8100
# 监听地址 (Bind host)
ECOVAULT_HOST=0.0.0.0
# 运行环境: development | production | test
NODE_ENV=development

# SQLite 数据库文件路径 (SQLite database file path)
ECOVAULT_DB_PATH=data/ecovault.db

# JWT 签名密钥 (生产环境务必替换为强随机值)
ECOVAULT_JWT_SECRET=Zm9vYmFyLWVjb3ZhdWx0LXNlY3JldC1rZXktY2hhbmdlLW1lLTEyMzQ1Njc4OTA=
# JWT 有效期 (毫秒), 默认 2 小时
ECOVAULT_JWT_EXPIRATION_MS=7200000
# 单用户允许同时在线的最大设备数
ECOVAULT_MAX_DEVICES=1

# 密码条目 AES-256-GCM 加密密钥 (生产环境务必替换)
ECOVAULT_CRYPTO_SECRET=ecovault-aes-secret-change-me-32b

# 初始管理员账户 (仅首次启动且不存在时创建)
ECOVAULT_ADMIN_USERNAME=admin
ECOVAULT_ADMIN_PASSWORD=Admin@123

# 应用日志级别: fatal | error | warn | info | debug | trace | silent
ECOVAULT_APP_LOG_LEVEL=info
