{
  "all": true,
  "include": ["src/**/*.js"],
  "exclude": [
    "src/server.js",
    "src/views/**",
    "test/**",
    "**/*.test.js"
  ],
  "reporter": ["text", "text-summary", "lcov", "html"],
  "report-dir": "coverage",
  "check-coverage": true,
  "lines": 80,
  "functions": 80,
  "branches": 75,
  "statements": 80
}
