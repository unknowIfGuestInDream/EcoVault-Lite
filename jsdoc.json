{
  "source": {
    "include": ["src", "README.md"],
    "includePattern": ".+\\.js$",
    "excludePattern": "(node_modules|docs-gen|coverage|test)"
  },
  "plugins": ["plugins/markdown"],
  "opts": {
    "encoding": "utf8",
    "destination": "docs-gen/",
    "recurse": true,
    "readme": "README.md"
  },
  "templates": {
    "cleverLinks": false,
    "monospaceLinks": false
  }
}
