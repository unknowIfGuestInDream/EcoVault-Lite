<!doctype html>
<html lang="zh-CN" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> · EcoVault Lite</title>
    <link rel="icon" href="/images/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/css/base.css" />
    <link rel="stylesheet" href="/css/dashboard.css" />
  </head>
  <body class="app-page">
    <div class="app-shell">
      <aside class="sidebar glass">
        <div class="sidebar__brand">
          <span class="brand-mark" aria-hidden="true">EV</span>
          <span class="sidebar__brand-text">EcoVault Lite</span>
        </div>
        <nav class="sidebar__nav" aria-label="主导航">
          <% menu.forEach(function (item) { %>
          <a
            class="nav-item<%= item.key === active ? ' nav-item--active' : '' %>"
            href="<%= item.path %>"
          >
            <span class="nav-item__label"><%= item.title %></span>
          </a>
          <% }); %>
        </nav>
      </aside>
      <div class="app-main">
        <header class="topbar glass">
          <h1 class="topbar__title"><%= title %></h1>
          <div class="topbar__actions">
            <button type="button" class="theme-toggle" id="theme-toggle" aria-label="切换主题">
              切换主题
            </button>
            <span class="topbar__user"><%= user.nickname || user.username %></span>
            <button type="button" class="btn btn--ghost" id="logout-btn">退出登录</button>
          </div>
        </header>
        <main
          class="content"
          id="app-content"
          data-active="<%= active %>"
          data-role="<%= user.role %>"
        >
          <section class="panel glass">
            <h2 class="panel__title"><%= title %></h2>
            <p class="panel__hint">当前模块已就绪，接口数据通过 REST API 加载。</p>
          </section>
        </main>
      </div>
    </div>
    <script src="/js/theme.js"></script>
    <script src="/js/api.js"></script>
    <script src="/js/dashboard.js"></script>
  </body>
</html>
